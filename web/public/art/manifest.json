{
 "version": 1,
 "basePath": "art/",
 "palette": {
  "ink": "#14160D",
  "brown": "#3A1D0E",
  "cream": "#F6EFDC",
  "mustard": "#F2C230",
  "rust": "#F0562B",
  "pink": "#F59AC4",
  "teal": "#0F7B6C",
  "sage": "#DDE3B5",
  "cobalt": "#2457A6"
 },
 "scene": {
  "size": {
   "cssWidth": 390,
   "cssHeight": 316,
   "note": "Every position is a percentage of the scene box, which must keep the 390/316 ratio. Assets are supplied at 3x."
  },
  "driver": {
   "variable": "--lift",
   "range": [
    0,
    1
   ],
   "meaning": "The Gap drives --lift. L = lift \u00d7 scene height is the distance the corner has travelled. Only animate --lift: everything else derives from it."
  },
  "layers": [
   {
    "order": 1,
    "class": "rs-floor",
    "src": "scene/floor.webp"
   },
   {
    "order": 2,
    "class": "rs-pile",
    "src": "scene/pile-{tier}.webp",
    "note": "tier 1..4, width percent from scene.pileTiers"
   },
   {
    "order": 3,
    "class": "rs-rugw",
    "wrapper": true,
    "child": "scene/rug-{zone}.webp",
    "note": "Wrapper holds the drop-shadow; the img holds the clip-path. Keep them separate or the shadow is clipped."
   },
   {
    "order": 4,
    "class": "rs-flapw",
    "wrapper": true,
    "child": "scene/flap.webp",
    "note": "Hide (or leave clipped to nothing) when lift is 0."
   },
   {
    "order": 5,
    "class": "rs-mascot",
    "src": "mascot/{expression}.webp"
   },
   {
    "order": 6,
    "class": "rs-hand",
    "src": "scene/hand.webp",
    "note": "Hide when zone is locked."
   },
   {
    "order": 7,
    "class": "rs-tag",
    "src": "scene/tag.webp"
   }
  ],
  "css": ".rug-scene{position:relative;aspect-ratio:390/316;overflow:hidden;--lift:0}\n.rug-scene>*{position:absolute}\n.rug-scene img{display:block;max-width:none}\n.rs-floor{inset:0;width:100%;height:100%}\n.rs-pile{right:3%;bottom:3%;height:auto}\n.rs-rugw{inset:0;filter:drop-shadow(-3px 3px 0 rgba(20,22,13,.6))}\n.rs-rugw img{position:absolute;inset:0;width:100%;height:100%;clip-path:polygon(0 0,100% 0,100% calc(100% - var(--lift)*100%),calc(100% - var(--lift)*81.0256%) 100%,0 100%)}\n.rs-flapw{left:calc(100% - var(--lift)*81.0256%);top:calc(100% - var(--lift)*100% - 12.6582%);width:81.0256%;height:112.6582%;filter:drop-shadow(-4px 5px 0 rgba(20,22,13,.55))}\n.rs-flapw img{width:100%;height:100%;clip-path:polygon(0 11.236%,calc(var(--lift)*100%) 11.236%,0 calc(11.236% + var(--lift)*88.764%))}\n.rs-hand{left:calc(100% - var(--lift)*81.0256% - 3.5897%);top:calc(100% - var(--lift)*100% - 15.1899%);height:30.3797%;width:auto}\n.rs-tag{left:44%;top:0;width:46.1538%;height:auto}\n.rs-mascot{left:5%;bottom:3%;height:47.5%;width:auto}\n",
  "pileTiers": {
   "1": {
    "widthPercent": 24
   },
   "2": {
    "widthPercent": 36
   },
   "3": {
    "widthPercent": 50
   },
   "4": {
    "widthPercent": 66
   }
  },
  "tagValueBox": {
   "note": "Where to put live HTML, in percent of the tag image",
   "left": 14,
   "top": 62,
   "width": 72,
   "height": 28
  },
  "zones": {
   "locked": {
    "rug": "scene/rug-locked.webp",
    "lift": 0,
    "mascot": "sleep",
    "hand": false
   },
   "cold": {
    "rug": "scene/rug-cold.webp",
    "lift": 0.04,
    "mascot": "one-eye",
    "hand": true
   },
   "warm": {
    "rug": "scene/rug-warm.webp",
    "liftRange": [
     0.1,
     0.55
    ],
    "mascot": "sweat",
    "hand": true,
    "note": "Map Gap -25% .. 0 linearly onto liftRange."
   },
   "live": {
    "rug": "scene/rug-live.webp",
    "lift": 0.92,
    "mascot": "panic",
    "hand": true
   }
  },
  "climax": {
   "note": "Animate --lift from its current value to 1 in about 0.4 s, then fade the rug and flap to leave floor and pile; swap the mascot to ripped."
  }
 },
